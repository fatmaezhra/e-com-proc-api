#%RAML 1.0
title: e-com-proc-api
types:
  productType: !include data-Type/ProductType.raml
  orderType: !include data-Type/OrderType.raml
/products:
  get:
    
    responses:
      200:
        body:
          application/json:
            type: productType[]
            example: !include example/ProductExample.raml

/orders:
  post:  
    body:
      application/json:
        type: orderType  
        example: !include example/OrderExample.raml  
        
    responses:
      201:
        body:
          application/json: 
            example:
              message: Commande créée avec succès
