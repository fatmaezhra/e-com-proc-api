#%RAML 1.0 DataType
type: object
properties:
  order:
    type: object
    properties:
      billingInfo:
        type: object
        properties:
          address:
            type: object
            properties:
              email:
                type: string
                required: true
              fullName:
                type: object
                properties:
                  firstName:
                    type: string
                    required: false
                  lastName:
                    type: string
                    required: false
                required: false
      shippingInfo:
        type: object
        properties:
          shipmentDetails:
            type: object
            properties:
              address:
                type: object
                properties:
                  email:
                    type: string
                    required: true
                  fullName:
                    type: object
                    properties:
                      firstName:
                        type: string
                        required: false
                      lastName:
                        type: string
                        required: false
                  country:
                    type: string
                  city:
                    type: string
                  phone:
                    type: string
      lineItems:
        type: array
        items:
          type: object
          properties:
            quantity:
              type: integer
              required: true
            name:
              type: string
              required: true
