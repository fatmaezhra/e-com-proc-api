#%RAML 1.0 DataType
type: object
properties:
  order:
    type: object
    properties:
      totals:
        type: object
        properties:
          subtotal: 
            type: string
            required: true
          shipping: 
            type: string
            required: false
          tax: 
            type: string
            required: false
          discount: 
            type: string
            required: false
          total: 
            type: string
            required: true
          
      billingInfo:
        type: object
        properties:
          paymentMethod: 
            type: string
            required: false
          paymentProviderTransactionId: 
            type: string
            required: false
          address:
            type: object
            properties:
              email: 
                type: string
                required: true
              fullName:
                type: object
                properties:
                  firstName: 
                    type: string
                    required: false
                  lastName: 
                    type: string
                    required: false
                required: false    
              country: 
                type: string
                required: false
              city: 
                type: string
                required: false
              zipCode: 
                type: string
                required: false
              phone: 
                type: string
                required: false

      shippingInfo:
        type: object
        properties:
          deliveryOption: 
            type: string
            required: false
          estimatedDeliveryTime: 
            type: string
            required: false
          shippingRegion: 
            type: string
            required: false
          shipmentDetails:
            type: object
            properties:
              address:
                type: object
                properties:
                  email: 
                    type: string
                    required: true
                  fullName:
                    type: object
                    properties:
                      firstName: 
                        type: string
                        required: false
                      lastName: 
                        type: string
                        required: false
                        
                  country: 
                    type: string
                  
                  city: 
                    type: string
                    
                  zipCode: 
                    type: string
                    required: false
                  phone: 
                    type: string
                    
              
              tax: 
                type: string
                required: false
              priceData:
                type: object
                properties:
                  price: 
                    type: string
                    required: false
                  taxIncludedInPrice: 
                    type: boolean
                    required: false
                required: false      

      paymentStatus:
        type: string
        required: true

      lineItems:
        type: array
        items:
          type: object
          properties:
            quantity: 
               type: integer
               required: true
            discount: 
               type: string
               required: false
            tax: 
               type: string
               required: false
            name: 
               type: string
               required: true
            productId: 
               type: string
               required: false
            lineItemType: 
               type: string
               required: false
            weight: 
               type: string
               required: false
            sku: 
               type: string
               required: false
            priceData:
              type: object
              properties:
                price: 
                  type: string
                  required: true
                taxIncludedInPrice: 
                  type: boolean
                  required: false

      channelInfo:
        type: object
        properties:
          type: 
            type: string
            required: true
