<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="Compte" doc:id="07af1dd9-8864-408f-b308-2de1b616ec6f" >
		<ee:transform doc:name="Transform Message" doc:id="7e18addf-1312-4fbe-8476-cf94072aef12" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
   
        Name: payload.nomCompte,
        Nom__c: payload.nom,
        Pr_nom__c: payload.prenom,
        Sexe__c: payload.sexe,
        age__c: payload.age,
        Phone: payload.telephone,
        emailAddress__c: payload.email,
        Moyen_de_Contact_Pr_f_r__c: payload.contactPref,
        Cat_gories_de_Produits_Services_Favoris__c: payload.categorieProduit,
        Produits_Favoris__c: payload.produitFavoris,
        Marques_Pr_f_r_es__c: payload.marquePreferee,
        nom_d_utilisateur__c: payload.username,
        mot_de_passe__c: payload.password,
        Confirmer_le_mot_de_passe__c: payload.confirmPassword
    }

]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="compte" doc:id="1760e34a-b7b3-48e6-99b0-0f11a2a42a87" message="compte#[payload]"/>
		<http:request method="POST" doc:name="Request" doc:id="99a837b2-9423-47d3-9630-0722d67b69f4" url="http://localhost:8081/salesforce-sys-api/v1/compte"/>
		<logger level="INFO" doc:name="Logger" doc:id="f79c8482-75e6-4b23-bee6-0b33b7375b8c" message="#[payload]"/>
	</sub-flow>
	<sub-flow name="Verif" doc:id="93fec3c3-9689-4fe7-95c7-685bed86453a" >
		<!-- [STUDIO:"username/password"]<logger level="INFO" doc:name="username/password" doc:id="e2590006-e47d-453a-b0ad-8da3d2886ebf" message="username#[vars.username&#93;,password#[password&#93;"/> [STUDIO] -->
		<http:request method="GET" doc:name="Request" doc:id="49de5e2c-ac22-4592-a648-baea5dee49bb" url="http://localhost:8081/salesforce-sys-api/v1/compte">
			<http:query-params ><![CDATA[#[output application/java
---
{
	"username" : vars.username,
	"password" : vars.password
}]]]></http:query-params>
		</http:request>
		<logger level="INFO" doc:name="Logger" doc:id="1dd73046-34b7-4864-86bb-5c4dc6d7173f" message="#[payload]"/>
		<choice doc:name="Choice" doc:id="94097bd0-02c3-4f44-8b7b-f54ceb071a52">
				<when expression="#[payload != []]">
					<ee:transform doc:name="coordonnés existe" doc:id="e5080192-0d47-4449-a163-c400fd637aca">
						<ee:message>
							<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "success": true,
    "message": "Connexion réussie"
}
]]></ee:set-payload>
						</ee:message>
					</ee:transform>
					<logger level="INFO" doc:name="Logger" doc:id="088dfb1f-dcc2-4e7b-9771-abb9f44337a3" message='#["coordonnés existe"]' />
				</when>
				<otherwise>
					<ee:transform doc:name="coordonnés n'exixte pas" doc:id="d21dff44-b61f-4628-947b-c1eb023902c9">
						<ee:message>
							<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    "success": false,
    "message": "Connexion non réussie"
}
]]></ee:set-payload>
						</ee:message>
					</ee:transform>
					<logger level="INFO" doc:name="Logger" doc:id="4281f348-62a4-4482-830f-4e1e548bcbec" message='#["coordonnés n existe pas"]' />
				</otherwise>
			</choice>
	</sub-flow>
</mule>
