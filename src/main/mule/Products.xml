		<choice doc:name="Choice" doc:id="16e84b3a-23b5-42cf-9cf7-a2fb51564e35" >
			<when expression='#[((vars.qprice default "") == "true") and !( (vars.qinstock default "") == "true")]'>
				<ee:transform doc:name="Transform Message" doc:id="0f53a24e-b0a7-40f9-ab87-f07150816e3c">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
(payload.name default []) zip (payload.brand default []) zip (payload.price default []) map ((item) -> {
    name: item[0][0],
    brand: item[0][1], 
    price: item[1]
   
         
})
]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<logger level="INFO" doc:name="Logger" doc:id="d3645f3a-caa6-4c45-9bb3-f16065a57a2b" message="apretchoice#[payload]"/>
			</when>
			<otherwise>
				<choice doc:name="Choice" doc:id="076e477b-4f76-4fce-a03b-a86781bd943d" >
					<when expression='#[((vars.qinstock default "") == "true") and !( (vars.qprice default "") == "true")]'>
						<ee:transform doc:name="Transform Message" doc:id="a8955144-0f83-4f0c-b3d3-d1a60d8d03d1" >
							<ee:message >
								<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
(payload.name default [])zip (payload.brand default []) zip (payload.inStock default []) map ((item) -> {
    name: item[0][0], 
    brand: item[0][1], 
    inStock: item[1]      
})
]]></ee:set-payload>
							</ee:message>
						</ee:transform>
					</when>
					<otherwise >
						<choice doc:name="Choice" doc:id="cbbff29a-6475-4689-82f4-e9afe26a4f42" >
							<when expression='#[((vars.qinstock default "") == "true") and ((vars.qprice default "") == "true")]'>
								<ee:transform doc:name="Transform Message" doc:id="ea355f96-c8c8-464e-856e-77878e42b0b9" >
									<ee:message >
										<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload 
    filter ((item) -> item.inStock == true) 
    map ((item) -> {
        name: item.name,
        brand: item.brand,
        price: item.price,
        inStock: item.inStock
    })
]]></ee:set-payload>
									</ee:message>
								</ee:transform>
							</when>
							<otherwise >
								<choice doc:name="Choice" doc:id="194a8df0-a9e7-4a7a-849f-9b38548d7fb0" >
									<when expression='#[(vars.qcolor  == "true")]'>
										<ee:transform doc:name="Transform Message" doc:id="93a51be0-d813-4c6d-9c25-368f707fb508" >
											<ee:message >
												<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
(payload.name default [])zip (payload.color default [])  map ((item) -> {
    name: item[0], 
    color: item[1], 
        
})
]]></ee:set-payload>
											</ee:message>
										</ee:transform>
									</when>
									<otherwise >
										<choice doc:name="Choice" doc:id="e467ba8d-15d0-4659-8e28-f648596e7144">
											<when expression='#[(vars.qsize  == "true")]'>
												<ee:transform doc:name="Transform Message" doc:id="53090b22-2a35-4c10-a41a-bd9ddddb5563" >
													<ee:message >
														<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
(payload.name default [])zip (payload.size default [])  map ((item) -> {
    name: item[0], 
    size: item[1], 
        
})
]]></ee:set-payload>
													</ee:message>
												</ee:transform>
											</when>
											<otherwise >
												<choice doc:name="Choice" doc:id="201ce43d-31dd-44ed-be95-9f371ee441dc">
													<when expression='#[(vars.qURL  == "true")]'>
														<ee:transform doc:name="Transform Message" doc:id="f3065a19-9617-4338-9e76-bf3d18b92e89" >
															<ee:message >
																<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
(payload.name default [])zip (payload.URL default [])  map ((item) -> {
    name: item[0], 
    URL: item[1], 
        
})
]]></ee:set-payload>
															</ee:message>
														</ee:transform>
													</when>
													<otherwise >
														<logger level="INFO" doc:name="No question" doc:id="eece50bb-152f-4a4e-b315-719ed88fbc9a" message="No question " />
														<ee:transform doc:name="No question" doc:id="430ba8e5-fb20-49c4-99fe-c64515934c9c">
									<ee:message>
										<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "message": "No question"
}
]]></ee:set-payload>
									</ee:message>
								</ee:transform>
													</otherwise>
												</choice>
											</otherwise>
										</choice>
									</otherwise>
								</choice>
							</otherwise>
						</choice>
					</otherwise>
				</choice>
			</otherwise>
		</choice>
	</sub-flow>
</mule>
