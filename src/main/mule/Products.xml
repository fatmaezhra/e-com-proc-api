<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<sub-flow name="Products" doc:id="b754f139-81d6-4179-98fd-593cd6907b79" >
		<logger level="INFO" doc:name="payload" doc:id="a5babe5b-3cb3-451d-b06c-a6a1cf19a150" message="#[payload]"/>
		<http:request method="GET" doc:name="Request" doc:id="d082aef9-842f-44ac-a420-755e4243d2fc" url="http://localhost:8081/e-com-sys-api/v1/products" />
		<logger level="INFO" doc:name="outputwix" doc:id="b8472e19-7178-422e-9160-e593322cd205" message="outputwix#[payload]" />
		<ee:transform doc:name="Transform Message" doc:id="a26111e3-a558-41b8-a864-563c12ad3826" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var productName = vars.qname
---
(payload.products default []) 
    filter ((item) -> item.name == productName) 
    map ((item) -> {
        name: item.name,
        inStock: item.stock.inStock default false,
        price: item.price.price default 0.0,
        brand: item.brand default "Unknown",
        size: 
            (item.productOptions default [])
                filter ((opt) -> opt.name == "Size") 
                flatMap ((sizeOption) -> 
                    (sizeOption.choices default [])
                        filter ((choice )-> choice.inStock)
                        map ((choice) -> choice.value)
                ),
        URL: item.media.mainMedia.image.url default "",
        color: 
            (item.productOptions default [])
                filter ((opt )-> opt.name == "Color") 
                flatMap ((colorOption) -> 
                    (colorOption.choices default [])
                        filter ((choice) -> choice.inStock)
                        map ((choice )-> choice.value)
                )
    })
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="4c4e0a71-58e6-485d-9bbd-8c86270ec66e" message="filter:#[payload]"/>
		<!-- [STUDIO:"Transform Message"]<ee:transform doc:name="Transform Message" doc:id="01d3c080-9d95-47b3-9091-a25e5b9eb9a2" >
